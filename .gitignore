# ============================================================
# .gitignore — 小学数学应用题自动解题
# ============================================================

# 模型权重和 checkpoint
outputs/checkpoints/
model_cache/
*.bin
*.safetensors
*.pt
*.pth

# wandb 日志
outputs/logs/
wandb/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# 环境
.env
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 数据文件（只忽略项目根目录下的 data/，不要误伤 src/data/）
/data/*
!/data/raw/
!/data/processed/
!/data/splits/
/data/raw/*
/data/processed/*
/data/splits/*


# OS
.DS_Store
Thumbs.db

# 保留目录结构
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/splits/.gitkeep
!outputs/checkpoints/.gitkeep
!outputs/submissions/.gitkeep
!outputs/logs/.gitkeep
