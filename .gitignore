# ============================================================
# .gitignore — 小学数学应用题自动解题
# ============================================================

# 模型权重和 checkpoint
outputs/checkpoints/
model_cache/
*.bin
*.safetensors
*.pt
*.pth

# wandb 日志
outputs/logs/
wandb/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# 环境
.env
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# 数据文件（JSON/CSV/JSONL 大文件，不跟踪）
data/raw/*.json
data/raw/*.csv
data/processed/*.json
data/processed/*.jsonl
data/processed/test/
data/processed/intermediate/
data/splits/*.json

# 保留目录结构的 .gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/splits/.gitkeep
!outputs/checkpoints/.gitkeep
!outputs/submissions/.gitkeep
!outputs/logs/.gitkeep

# 提交结果
outputs/submissions/*.csv

# docs

docs/
outputs/
data/processed/intermediate/
